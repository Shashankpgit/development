# --- Option 1: Local Development (Default) ---
# Uses a simple SQLite file (test.db) in the current directory.
# Good for quick testing without running any database containers.
# DATABASE_URL=sqlite:///./test.db

# --- Option 2: Local Development with Kubernetes Port-Forwarding ---
# Use this when running the app LOCALLY (python main.py) but connecting to a DB in MINIKUBE/K8S.
# Prerequisite: kubectl port-forward -n postgresql svc/postgresql 5432:5432
DATABASE_URL=postgresql://postgres-user:postgres-ps@localhost:5432/postgres-db

# --- Option 3: Production / Running INSIDE Kubernetes ---
# Use this when the backend itself is running as a pod in the cluster.
# It connects directly to the postgres service using the internal DNS name.
# Format: postgresql://<user>:<password>@<service-name>.<namespace>.svc.cluster.local:5432/<dbname>
# DATABASE_URL=postgresql://postgres-user:postgres-ps@postgresql.postgresql.svc.cluster.local:5432/postgres-db

PORT=8000
