# infra/config.env
# The only file you need to edit before running bootstrap.sh.
# All resource names are derived from these four values — nothing is hardcoded elsewhere.
#
# Naming convention: {ENV_NAME}-{APP_NAME}-{resource_type}
# Examples:
#   VPC           → dev-vault-vpc
#   Subnet        → dev-vault-subnet
#   GKE cluster   → dev-vault-cluster
#   State bucket  → dev-vault-backend
#
# NOTE: GCS bucket names are globally unique across all of GCP.
# If bootstrap fails with "bucket already exists", the name is taken by another GCP
# project. Fix: append a short unique suffix to APP_NAME e.g. APP_NAME="vault-abc".
#
# To create a prod environment: change ENV_NAME to "prod" and re-run bootstrap.sh.

# ── GCP project ───────────────────────────────────────────────────────────────
export GCP_PROJECT_ID="learning-gcp-496710"
export GCP_REGION="asia-south1"

# ── Environment and application identifiers ───────────────────────────────────
# ENV_NAME : the deployment environment — dev | stage | prod
# APP_NAME : the application these resources belong to
export ENV_NAME="dev"
export APP_NAME="vault"

# Suffix added to the GCS bucket name to guarantee global uniqueness across GCP.
# Using the numeric part of the project ID — already unique, easy to trace back.
# Bucket name: {env}-{app}-backend-{suffix}  →  dev-vault-backend-496710
export BUCKET_SUFFIX="496710"
