# infra/infra.env.example
# Copy this file to infra/infra.env and fill in your values.
# infra/infra.env is gitignored — never commit real project IDs to git.
#
# Usage:
#   cp infra/infra.env.example infra/infra.env
#   # edit infra/infra.env
#   ./scripts/vault-infra.sh login
#   ./scripts/vault-infra.sh create-backend
#   ./scripts/vault-infra.sh apply

# ── GCP project ───────────────────────────────────────────────────────────────
export GCP_PROJECT_ID="your-gcp-project-id"   # e.g. "vault-project-123456"
export GCP_REGION="asia-south1"                # region for cluster, NAT, static IP

# ── State backend ─────────────────────────────────────────────────────────────
# GCS bucket for OpenTofu remote state. Must be globally unique across all of GCP.
# Recommended pattern: "<project-id>-tofu-state"
export TF_STATE_BUCKET="your-project-id-tofu-state"

# ── OpenTofu service account ──────────────────────────────────────────────────
# Short name (account_id) — full email is derived as:
# <TOFU_SA_NAME>@<GCP_PROJECT_ID>.iam.gserviceaccount.com
export TOFU_SA_NAME="opentofu-sa"

# ── Network ───────────────────────────────────────────────────────────────────
export VPC_NAME="vault-vpc"
export SUBNET_NAME="vault-subnet"
export SUBNET_CIDR="10.0.0.0/24"        # primary range — node IPs

# Secondary ranges for GKE VPC-native mode.
# These must NOT overlap with each other or with SUBNET_CIDR.
export PODS_RANGE_NAME="pods"
export PODS_CIDR="10.1.0.0/16"          # up to 65,536 pod IPs

export SERVICES_RANGE_NAME="services"
export SERVICES_CIDR="10.2.0.0/20"      # up to 4,096 service IPs

# ── GKE cluster ───────────────────────────────────────────────────────────────
export CLUSTER_NAME="vault-cluster"
export NODE_POOL_NAME="vault-nodes"
export MACHINE_TYPE="e2-standard-2"     # 2 vCPU, 8 GB RAM per node
export NODE_COUNT="2"
export DISK_SIZE_GB="50"
# Pin the Kubernetes version. Check available versions with:
#   gcloud container get-server-config --region $GCP_REGION
export K8S_VERSION="1.30"
