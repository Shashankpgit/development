# The URL of your Python/FastAPI Backend.
# 
# 1. Local Development: usually http://localhost:8000
# 2. Kubernetes via Ingress: usually https://api.yourdomain.com
# 3. Kubernetes via NodePort/LoadBalancer: http://<node-ip>:<node-port>
# 
# NOTE: This must be reachable from the USER'S browser, not just from inside the cluster.
VITE_API_URL=http://localhost:8000
