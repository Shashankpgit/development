# Python
__pycache__/
*.pyc
.venv/
venv/
*.db

# Node
node_modules/
dist/

# Environment -- never commit real credentials
.env
.env.local
*.local.yaml

# Machine-local notes. This file CLAIMS to be gitignored, so make it true --
# it holds a Docker Hub password in plain text.
CLAUDE.local.md

# Editors / OS
.vscode/
.idea/
.DS_Store

# OpenTofu / Terraform
# .terraform/ holds downloaded provider binaries -- hundreds of MB, and
# machine-specific. .terraform.lock.hcl IS committed (it pins provider
# versions, which is the point).
.terraform/
.terragrunt-cache/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Generated by terragrunt's `generate` blocks in root.hcl -- regenerated on
# every run, so committing them would just create noise and drift.
backend.tf
provider.tf

# Written by create_tf_backend.sh. Contains your AWS account id in the bucket
# name, and is regenerated per account, so it is local-only.
tf.sh
